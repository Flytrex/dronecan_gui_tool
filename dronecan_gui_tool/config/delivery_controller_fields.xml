<?xml version="1.0" encoding="UTF-8"?>
<!--
  Delivery Controller field definitions.

  Each field uses the format:
    field_name, field_type, default_value

  Notes:
  - field_type should be compatible with UAVCAN/DroneCAN DSDL primitive type names
    (e.g., uint32, int16, float32, float64, bool, uint8[16], uint8[<=16]).
  - default_value is stored as text and should be parseable according to field_type.
  - Fields with edit="false" are read-only and are populated from 21010.StateReport.uavcan.
  - Fields with edit="true" are (planned to be) sent via a DirectOverride broadcast.
-->
<fields>
  <field name="safety_state" type="bool" default="0" comment="The current safety state" edit="false" />
  <field name="readiness" type="uint2" default="0" comment="The current motion coordinate frame readiness" edit="false" />
  <field name="mode" type="uint7" default="0" comment="The current active mode" edit="false" />
  <field name="mode_execution_state" type="uint2" default="0" comment="0 = IN PROGRESS; 1 = DONE; 2 = ERROR" edit="false" />
  <field name="error" type="uint10" default="0" comment="The current error, if any" edit="false" />
  <field name="package_state" type="uint2" default="0" comment="The current package status" edit="false" />
  <field name="wire_extension_m" type="float32" default="0.0" comment="The wire extension in meters" edit="false" />
  <field name="load_speed_m_s" type="float32" default="0.0" comment="The load speed in meters per second" edit="false" />
  <field name="force_on_wire_N" type="float32" default="0.0" comment="The force on the wire in Newtons" edit="false" />
  <field name="estimated_weight_kg" type="float32" default="0.0" comment="The estimated weight of the package in kg" edit="false" />
</fields>
